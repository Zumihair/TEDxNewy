{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/motifs/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|children|icon|disabled|onClick|type|className|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, children, icon, disabled, onClick, type, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|red|secondary|cream|white|dark|outline-dark|outline-light|ghost-light)$/]",
        "message": "<Button> variant must be one of 'primary' | 'red' | 'secondary' | 'cream' | 'white' | 'dark' | 'outline-dark' | 'outline-light' | 'ghost-light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:arrow-right|arrow-up-right|play|mail)$/]",
        "message": "<Button> icon must be one of 'arrow-right' | 'arrow-up-right' | 'play' | 'mail'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|hoverable|as|href|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padding, hoverable, as, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:div|a|li|article)$/]",
        "message": "<Card> as must be one of 'div' | 'a' | 'li' | 'article'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CircleArrowLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|size|color|style|key|ref|className|style|children)$/]",
        "message": "<CircleArrowLink> doesn't accept that prop. Declared props: href, children, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CircleArrowLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<CircleArrowLink> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountdownClock'] > JSXAttribute > JSXIdentifier[name!=/^(?:target|label|key|ref|className|style|children)$/]",
        "message": "<CountdownClock> doesn't accept that prop. Declared props: target, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditionStamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<EditionStamp> doesn't accept that prop. Declared props: text, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditionStamp'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<EditionStamp> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|image|imageAlt|imageGradient|label|labelAccent|title|meta|description|linkLabel|key|ref|className|style|children)$/]",
        "message": "<EventRow> doesn't accept that prop. Declared props: href, image, imageAlt, imageGradient, label, labelAccent, title, meta, description, linkLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventRow'] > JSXAttribute[name.name='labelAccent'] > Literal[value!=/^(?:red|neutral)$/]",
        "message": "<EventRow> labelAccent must be one of 'red' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:q|a|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: q, a."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|required|hint|type|placeholder|textarea|rows|select|options|defaultValue|style|key|ref|className|style|children)$/]",
        "message": "<FormField> doesn't accept that prop. Declared props: label, name, required, hint, type, placeholder, textarea, rows, select, options, defaultValue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel|url)$/]",
        "message": "<FormField> type must be one of 'text' | 'email' | 'tel' | 'url'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NodeNetwork'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|opacity|style|key|ref|className|style|children)$/]",
        "message": "<NodeNetwork> doesn't accept that prop. Declared props: variant, opacity, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NodeNetwork'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<NodeNetwork> variant must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|intro|body|meta|key|ref|className|style|children)$/]",
        "message": "<PageHero> doesn't accept that prop. Declared props: kicker, title, intro, body, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='ParticipateCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|title|body|image|gradient|cta|ratio|key|ref|className|style|children)$/]",
        "message": "<ParticipateCard> doesn't accept that prop. Declared props: href, title, body, image, gradient, cta, ratio."
      },
      {
        "selector": "JSXOpeningElement[name.name='PastEventCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|image|imageAlt|imageGradient|date|title|subtitle|cta|key|ref|className|style|children)$/]",
        "message": "<PastEventCard> doesn't accept that prop. Declared props: href, image, imageAlt, imageGradient, date, title, subtitle, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoPending'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|key|ref|className|style|children)$/]",
        "message": "<PhotoPending> doesn't accept that prop. Declared props: title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|amber|coast|cream)$/]",
        "message": "<Pill> tone must be one of 'red' | 'amber' | 'coast' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RedCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|opacity|style|key|ref|className|style|children)$/]",
        "message": "<RedCircle> doesn't accept that prop. Declared props: size, opacity, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionKicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|accent|inverted|showRule|style|key|ref|className|style|children)$/]",
        "message": "<SectionKicker> doesn't accept that prop. Declared props: label, accent, inverted, showRule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionKicker'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:red|amber|coast|white)$/]",
        "message": "<SectionKicker> accent must be one of 'red' | 'amber' | 'coast' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|description|imageUrl|gradient|ctaLabel|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, href, description, imageUrl, gradient, ctaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeakerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|title|image|onClick|key|ref|className|style|children)$/]",
        "message": "<SpeakerCard> doesn't accept that prop. Declared props: name, title, image, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselSpeaker'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|title|image|key|ref|className|style|children)$/]",
        "message": "<CarouselSpeaker> doesn't accept that prop. Declared props: name, title, image."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|suffix|suffixColor|label|sub|tone|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, suffix, suffixColor, label, sub, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Stat> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubscribeForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|cta|onSubmit|key|ref|className|style|children)$/]",
        "message": "<SubscribeForm> doesn't accept that prop. Declared props: placeholder, cta, onSubmit."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
