{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chrome/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "ui_kits/admin/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|icon|type|disabled|pending|fullWidth|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, icon, type, disabled, pending, fullWidth, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padded|className|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padded, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|body|confirmLabel|cancelLabel|tone|onConfirm|onCancel|key|ref|className|style|children)$/]",
        "message": "<ConfirmDialog> doesn't accept that prop. Declared props: open, title, body, confirmLabel, cancelLabel, tone, onConfirm, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:danger|neutral)$/]",
        "message": "<ConfirmDialog> tone must be one of 'danger' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DashboardTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:section|icon|title|count|tool|feature|href|onClick|key|ref|className|style|children)$/]",
        "message": "<DashboardTile> doesn't accept that prop. Declared props: section, icon, title, count, tool, feature, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='DashboardTile'] > JSXAttribute[name.name='section'] > Literal[value!=/^(?:yellow|coast|red|green|grey)$/]",
        "message": "<DashboardTile> section must be one of 'yellow' | 'coast' | 'red' | 'green' | 'grey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataList'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<DataList> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateTimePicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|withTime|placeholder|id|name|inline|key|ref|className|style|children)$/]",
        "message": "<DateTimePicker> doesn't accept that prop. Declared props: value, onChange, withTime, placeholder, id, name, inline."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|htmlFor|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, htmlFor, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Flash'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Flash> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Flash'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|info|error)$/]",
        "message": "<Flash> tone must be one of 'ok' | 'info' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:trigger|title|size|defaultOpen|children|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: trigger, title, size, defaultOpen, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|wide|xl)$/]",
        "message": "<Modal> size must be one of 'default' | 'wide' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotSetUp'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|key|ref|className|style|children)$/]",
        "message": "<NotSetUp> doesn't accept that prop. Declared props: title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:section|eyebrow|title|description|backHref|actions|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: section, eyebrow, title, description, backHref, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkeletonBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|radius|key|ref|className|style|children)$/]",
        "message": "<SkeletonBar> doesn't accept that prop. Declared props: width, height, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|iconName|section|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: href, label, iconName, section."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute[name.name='section'] > Literal[value!=/^(?:yellow|coast|red|green|grey)$/]",
        "message": "<SidebarItem> section must be one of 'yellow' | 'coast' | 'red' | 'green' | 'grey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:stage|count|label|key|ref|className|style|children)$/]",
        "message": "<StageHeading> doesn't accept that prop. Declared props: stage, count, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<StatChip> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tab'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|count|key|ref|className|style|children)$/]",
        "message": "<Tab> doesn't accept that prop. Declared props: key, label, count."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
