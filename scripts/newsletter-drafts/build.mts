/**
 * Turns the draft definitions in ./drafts/*.mts into one idempotent SQL file
 * that loads them into /admin/newsletter/campaigns as DRAFTS (status draft,
 * stage early, no schedule, so nothing can send).
 *
 *   npx tsx scripts/newsletter-drafts/build.mts            # all drafts
 *   npx tsx scripts/newsletter-drafts/build.mts <slug>...  # just these
 *
 * Writes supabase/migrations/<date>_newsletter_drafts_<slug|batch>.sql.
 * Paste that into the Supabase SQL editor (nothing in this repo can write to
 * the live database). Safe to re-run: a draft is skipped if a newsletter with
 * the same title already exists, so editing one in the admin is never undone.
 * To replace a draft, delete it in the admin first, then re-run the SQL.
 */
import { readdirSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import { validateBlocks } from "../../lib/newsletter-blocks";
import { makeNext, type Draft } from "./dsl.mts";

const here = dirname(fileURLToPath(import.meta.url));
const only = process.argv.slice(2);

const files = readdirSync(join(here, "drafts"))
  .filter((f) => f.endsWith(".mts"))
  .filter((f) => only.length === 0 || only.includes(f.replace(/\.mts$/, "")));

if (files.length === 0) {
  console.error("No matching drafts in scripts/newsletter-drafts/drafts/");
  process.exit(1);
}

const q = (s: string) => `'${s.replace(/'/g, "''")}'`;
const dash = /[–—]/;
const parts: string[] = [];

for (const f of files) {
  const mod = (await import(pathToFileURL(join(here, "drafts", f)).href)) as {
    default: Draft;
  };
  const d = mod.default;
  const raw = d.blocks(makeNext(d.slug));
  const blocks = validateBlocks(raw);
  if (blocks.length !== raw.length) {
    throw new Error(`${d.slug}: validateBlocks dropped ${raw.length - blocks.length} block(s)`);
  }
  const json = JSON.stringify(blocks);
  if (dash.test(json + d.subject + d.preheader + d.title)) {
    throw new Error(`${d.slug}: contains an em or en dash (house rule: rephrase)`);
  }
  if (json.includes("$nl$")) throw new Error(`${d.slug}: contains the SQL quote tag`);
  parts.push(`-- ${d.slug}
insert into public.newsletters
  (title, subject, preheader, audience, blocks, status, stage)
select
  ${q(d.title)},
  ${q(d.subject)},
  ${q(d.preheader)},
  ${q(d.audience)},
  $nl$${json}$nl$::jsonb,
  'draft',
  'early'
where not exists (
  select 1 from public.newsletters where title = ${q(d.title)}
);
`);
  console.log(`${d.slug}: ${blocks.length} blocks, audience ${d.audience}`);
}

const date = new Date().toISOString().slice(0, 10).replace(/-/g, "");
const name = files.length === 1 ? files[0].replace(/\.mts$/, "") : "batch";
const out = join(here, "..", "..", "supabase", "migrations", `${date}_newsletter_drafts_${name}.sql`);
writeFileSync(
  out,
  `-- Newsletter DRAFTS generated by scripts/newsletter-drafts/build.mts.
-- Inserts as status 'draft' / stage 'early'; nothing here schedules or sends.
-- Skips any draft whose title already exists. Safe to re-run.

${parts.join("\n")}`,
);
console.log(`Wrote ${out}`);
