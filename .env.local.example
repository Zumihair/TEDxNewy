# Copy this file to .env.local and fill the values.
# These are also set in Vercel under claused/tedxnewy → Project Settings → Environment Variables.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Resend — for transactional emails (e.g. admin notifications when a school
# submits a Youth Futures Lab EOI). Get an API key at https://resend.com.
# Leave RESEND_API_KEY unset to no-op email sends in local dev.
RESEND_API_KEY=re_...
# Optional: override the From address. Defaults to Resend's sandbox sender.
# Once tedxnewy.com.au is verified in Resend, change to something like:
# RESEND_FROM=TEDxNewy <noreply@tedxnewy.com.au>
RESEND_FROM=

# Buffer — publishes /admin/socials posts to Instagram, Facebook and
# LinkedIn (lib/buffer-social.ts). Connect the 3 channels in Buffer's own
# dashboard first, then generate a personal API key at
# https://publish.buffer.com/settings/api. Leave unset to keep every channel
# on the manual "post it by hand" run sheet.
# CURRENT KEY EXPIRES 10 AUGUST 2027 (1-year key) — regenerate before then
# and update this var locally and in Vercel. The expiry also shows on the
# Connections card in /admin/socials.
BUFFER_API_KEY=

# Apollo.io — powers "Find contacts" and "Suggest prospects" on
# /admin/partners/[id] (lib/apollo.ts). Get a key at apollo.io. Leave unset
# to hide both tools; the rest of the Partners page works without it.
APOLLO_API_KEY=
